# --- Core -------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/smart_tourist
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies (the portal)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Health identity (report §2.2-F) ----------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Salt for TokenID = SHA-256(NationalID || Salt)
HEALTH_ID_SALT=
# AES-256-GCM key that encrypts emergency clinical profiles. Share ONLY with authorised
# responders (the portal's Responder page can store it for offline decryption).
RESPONDER_KEY=
# Seed of the Ed25519 key that signs Emergency QR tokens (public key: GET /api/health/responder/public-key)
QR_SIGNING_SEED=
# Without these three, the server uses fixed development keys and logs a warning.

# --- Blockchain trust layer (optional) ----------------------------------------
# Without these the server records soulbound permits in a hash-chained MongoDB ledger.
# Local:   cd chain && npx hardhat node   then   npm run chain:deploy:local
# Polygon: set AMOY_RPC_URL / AMOY_PRIVATE_KEY as Hardhat config variables, npm run chain:deploy:amoy
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
# Address printed by the TouristHealthRegistry deployment
HEALTH_REGISTRY_ADDRESS=
# Legacy TouristRegistry contract (original project)
CONTRACT_ADDRESS=
