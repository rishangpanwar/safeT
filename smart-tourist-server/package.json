{
  "name": "smart-tourist-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "demo": "tsx src/demo/start.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate-telemetry.ts",
    "evaluate": "tsx ../evaluation/run-accuracy.ts",
    "chain:compile": "cd chain && hardhat build",
    "chain:test": "cd chain && hardhat test nodejs",
    "chain:deploy:local": "cd chain && hardhat ignition deploy ignition/modules/TouristHealthRegistry.ts",
    "chain:deploy:amoy": "cd chain && hardhat ignition deploy ignition/modules/TouristHealthRegistry.ts --network polygonAmoy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AI-Powered Smart Tourist Health, Safety & Emergency Response System — API server",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ether": "^0.0.9",
    "ethers": "^6.15.0",
    "express": "^4.17.1",
    "geolib": "^3.3.4",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "nodemon": "^3.1.10",
    "qrcode": "^1.5.4",
    "rimraf": "^6.0.1",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^24.6.1",
    "@types/qrcode": "^1.5.5",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.6",
    "mongodb-memory-server-core": "^10.4.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "viem": "^2.37.9"
  },
  "type": "commonjs"
}
